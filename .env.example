# Copie este arquivo para `.env` e preencha os valores reais

# --- API publica de integracao (documentada em /swagger) ---
NEXTFIT_API_KEY=
NEXTFIT_BASE_URL=https://integracao.nextfit.com.br
NEXTFIT_API_VERSION=1

# --- PostgreSQL VPS/Coolify ---
# Use o host interno do recurso postgres-ct no Coolify.
DATABASE_URL=postgresql://nextfit_user:SENHA@HOST_INTERNO_POSTGRES:5432/nextfit

# --- Google Sheets ---
# ID da planilha (pegue da URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEET_ID=
# Caminho do JSON da service account do Google Cloud
GOOGLE_CREDENTIALS_FILE=credentials/service-account.json
# Em produção, use o JSON completo em uma variável secreta e não envie arquivo:
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- API v2 interna (opcional, para puxar presencas/acessos/catraca/treinos) ---
# JWT Bearer extraido do DevTools do painel (api.nextfit.com.br).
# Expira em ~10h, mas renova automaticamente usando o refresh_token.
# Como pegar na primeira vez: https://app.nextfit.com.br -> F12 -> Console ->
#   localStorage.getItem("X-AUTH-TOKEN")  e  localStorage.getItem("X-REFRESH-TOKEN")
NEXTFIT_V2_TOKEN=
# Refresh token (validade ~5 dias) — usado pra renovar o access token sem captcha
NEXTFIT_V2_REFRESH_TOKEN=
# Codigo da unidade (aparece no painel ou no JWT como codigoUnidadePreferencial)
NEXTFIT_CODIGO_UNIDADE=
# Periodo das presencas. Escolha UM dos dois:
# (A) Data inicial fixa (formato YYYY-MM-DD). Se definida, tem prioridade.
NEXTFIT_PRESENCAS_DATA_INICIAL=
# (B) Quantos dias pra tras a partir de hoje (usado quando DATA_INICIAL esta vazio)
NEXTFIT_PRESENCAS_DIAS=30
# Janela historica (dias) usada pelo script ativos_sem_presenca.py pra calcular
# "ultimo acesso" de cada aluno. Quanto maior, mais abrangente, mais lento. Default 180.
NEXTFIT_HISTORICO_DIAS=180

# --- Controle Professores ---
# ID da planilha 'Controle Professores' (criada por:
#   python -m controle_professores.setup --share seu_email@gmail.com)
CONTROLE_PROFESSORES_SHEET_ID=

# --- Portal web (FastAPI + React) ---
APP_ENV=development
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
# Hash scrypt gerado de forma interativa por: python scripts/hash_portal_password.py
APP_PASSWORD_HASH=
# Objeto JSON nome -> hash scrypt. Ex.: {"Professor":"scrypt$...$..."}
PROFESSOR_PASSWORD_HASHES_JSON={}
# Compatibilidade temporária; prefira os hashes acima.
APP_PASSWORD=
PROFESSOR_PASSWORDS_JSON={}
# Origens adicionais apenas para desenvolvimento separado.
CORS_ORIGINS=http://localhost:5173
FRONTEND_DIST=frontend/dist
LOG_LEVEL=INFO

# Comandos de ingestao para VPS/Coolify:
#   python -m nextfit_sync
#   python -m sync_portal_alunos
#   python -m aniversariantes_do_dia
#   python -m sheets_to_postgres
#   python -m nextfit_v2_sync --endpoint presencas

# --- Sistema de cronometragem HYROX ---
# Senha obrigatoria do ADMINISTRADOR (se vazia, o login fica bloqueado).
HYROX_ADMIN_PASSWORD=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
HYROX_SECRET_KEY=
HYROX_DATABASE_PATH=data/hyrox.db
HYROX_PUBLIC_BASE_URL=http://localhost:8600
# Ative somente em desenvolvimento para executar: python -m hyrox.seed_demo
HYROX_ENABLE_DEMO=false
# true: cadastro rápido somente local, sem escrever no Next Fit.
HYROX_TEMPORARY_STUDENTS=true
